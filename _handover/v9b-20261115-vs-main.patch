index 0000000..5cc5b59
--- /dev/null
+++ b/tools/v9b/diagnose_v9a.py
@@ -0,0 +1,249 @@
+"""Join V9-A's frozen native-seam witnesses to its actual Worker trace."""
+
+import argparse
+import json
+import sqlite3
+import sys
+from collections import Counter
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "b5"))
+from b5_data import read_jsonl, sha256, write_json
+from b5_factory import distance, motif
+
+
+def core(quality):
+    return {"dom": "maj", "hdim": "dim"}.get(quality, quality)
+
+
+def bass(chord):
+    return chord["root"] if chord["bass"] is None else chord["bass"]
+
+
+def tones(chord, shift=0):
+    return {(chord["root"] + i + shift) % 12 for i in chord["intervals"]} | {
+        (bass(chord) + shift) % 12
+    }
+
+
+def chord_conflicts(actual, source, shift):
+    """Static cross-check of Contextual compatible(), with exported pitches."""
+    checks = {
+        "root": actual["root"] != (source["root"] + shift) % 12,
+        "quality": core(actual["quality"]) != core(source["quality"]),
+        "explicit_bass": actual["bass"] is not None and actual["bass"] != (bass(source) + shift) % 12,
+        "actual_tones_not_subset": not tones(actual) <= tones(source, shift),
+    }
+    return [name for name, found in checks.items() if found]
+
+
+def project_key(source, actual_root, source_root):
+    shift = (actual_root - source_root) % 12
+    return (source["tonic"] + shift) % 12 + 12 * source["mode"], shift
+
+
+def explain_path(query, replay, source, next_index, key, shift, near_distance):
+    source_id = source["source"]
+    exact = [item for item in replay["exact_trace"] if item["source"] == source_id and item["key"] == key]
+    contextual = [item for item in replay["context_trace"] if item["source"] == source_id
+                  and item["key"] == key and item["next"] == next_index]
+    at_end = [item for item in exact if item["next"] == next_index]
+    retained = {"TARGET_RETAINED", "EXPLORATORY_RETAINED"}
+    exact_reason = at_end[0]["disposition"] if at_end else ("alternate_endpoint" if exact else "untried_key")
+    contextual_reason = (contextual[0]["disposition"] if contextual else
+                         "no_internal_anchor" if next_index < 2 else "untried_key")
+    primary = [item for item in replay["candidates"] if item["source"] == source_id
+               and item["next"] == next_index and item["key"] == key]
+    evidence = [item for item in replay["candidates"] if any(entry["source"] == source_id
+                and entry["next"] == next_index and entry["key"] == key
+                for entry in item["evidence"])]
+    conflicts = [chord_conflicts(actual, expected, shift) for actual, expected in zip(
+        reversed(query["prefix"][-next_index:]), reversed(source["events"][:next_index]))]
+    return dict(source=source_id, next=next_index, key=key, near_distance=near_distance,
+                exact_reason=exact_reason, contextual_reason=contextual_reason,
+                exact_aligned=exact, contextual_trace=contextual,
+                exact_qualified=exact_reason in retained,
+                contextual_qualified=contextual_reason == "qualified-before-structure",
+                primary_ranks=[item["product_rank"] for item in primary],
+                evidence_ranks=[item["product_rank"] for item in evidence],
+                context_conflicts_from_latest=conflicts,
+                two_event_context_compatible=len(conflicts) >= 2 and not any(conflicts[:2]))
+
+
+def explain_witnesses(queries, replays, sources):
+    witnesses = []
+    for query, replay in zip(read_jsonl(queries), read_jsonl(replays), strict=True):
+        assert query["id"] == replay["id"]
+        anchor = query["prefix"][-1]["root"]
+        target = motif(query["target"], anchor)
+        details = []
+        for source in sources.values():
+            events = source["events"]
+            for next_index in range(1, len(events)):
+                current, following = events[next_index - 1:next_index + 1]
+                if (current["root"], current["quality"]) == (following["root"], following["quality"]):
+                    continue  # same L1 event; matches V9-A catalog()
+                near = distance(target, motif(events[next_index:], current["root"]))
+                if near > 1:
+                    continue
+                key, shift = project_key(source, anchor, current["root"])
+                details.append(explain_path(query, replay, source, next_index, key, shift, near))
+        if details:
+            witnesses.append(dict(id=query["id"], routes=details, all_candidates=len(replay["candidates"])))
+    return witnesses
+
+
+def explain_controls(queries, replay, sources, failed):
+    results = []
+    for query, played in zip(read_jsonl(queries), read_jsonl(replay), strict=True):
+        assert query["id"] == played["id"]
+        if query["id"] not in failed:
+            continue
+        source = sources[query["id"]]
+        index = len(query["prefix"])
+        key = source["tonic"] + 12 * source["mode"]
+        details = explain_path(query, played, source, index, key, 0, 0)
+        current, following = query["prefix"][-1], query["target"][0]
+        details["source_boundary"] = dict(from_event=current, to_event=following,
+                                          common_tone_count=len(tones(current) & tones(following)),
+                                          bass_leap=min((bass(following) - bass(current)) % 12,
+                                                        (bass(current) - bass(following)) % 12))
+        results.append(details)
+    return results
+
+
+def read_db(path):
+    with sqlite3.connect(path.resolve().as_uri() + "?immutable=1", uri=True) as conn:
+        return dict(conn.execute("SELECT id, payload FROM progressions"))
+
+
+def projection_summary(v9a, directory, sources, outcomes):
+    baseline_db = v9a / "library/factory.db"
+    rewritten_db = directory / "diagnosis_projection.db"
+    raw_before = read_db(baseline_db)
+    raw_after = read_db(rewritten_db)
+    assert raw_before.keys() == raw_after.keys()
+    functions, changed_sources = Counter(), []
+    for source, payload in raw_before.items():
+        rewritten = raw_after[source]
+        if payload == rewritten:
+            continue
+        assert source in sources
+        original = json.loads(payload)
+        updated = json.loads(rewritten)
+        source_notes = json.loads(original.pop("typedData"))
+        changed_notes = json.loads(updated.pop("typedData"))
+        assert original == updated
+        for a, b in zip(source_notes["full"], changed_notes["full"], strict=True):
+            if a["function"] != b["function"]:
+                assert a["function"] == 0
+                functions[str(b["function"])] += 1
+                a["function"] = b["function"]
+        assert source_notes == changed_notes
+        changed_sources.append(source)
+    control_queries = v9a / "materials/controls.jsonl"
+    controls = directory / "diagnosis_projection_replay/factory_replay.jsonl"
+    native_hits = set()
+    for query, replay in zip(read_jsonl(control_queries), read_jsonl(controls), strict=True):
+        assert query["id"] == replay["id"]
+        source = sources[query["id"]]
+        target = query["target"]
+        if any(candidate["key"] == source["tonic"] + 12 * source["mode"] and
+               candidate["source"] == source["source"] and candidate["next"] == len(query["prefix"]) and
+               candidate["source_end_preserved"] and len(candidate["events"]) == len(target) and
+               all((a["root"], bass(a), a["intervals"]) == (b["root"], bass(b), b["intervals"]) and
+                   abs(a["duration"] - b["duration"]) <= 1e-6
+                   for a, b in zip(candidate["events"], target, strict=True))
+               for candidate in replay["candidates"]):
+            native_hits.add(query["id"])
+    queries = v9a / "confirmation/confirmation.jsonl"
+    before = v9a / "confirmation-v9-trace/factory_replay.jsonl"
+    after = directory / "diagnosis_projection_development/factory_replay.jsonl"
+    native = explain_witnesses(queries, after, sources)
+    near_before, near_after, lost = set(), set(), []
+    count_before, count_after = 0, 0
+    for query, old, new in zip(read_jsonl(queries), read_jsonl(before), read_jsonl(after), strict=True):
+        assert query["id"] == old["id"] == new["id"]
+        a = {c["fingerprint"]: c for c in old["candidates"]}
+        b = {c["fingerprint"]: c for c in new["candidates"]}
+        target = motif(query["target"], query["prefix"][-1]["root"])
+        for candidates, near in ((a, near_before), (b, near_after)):
+            if any(distance(target, motif(c["events"], query["prefix"][-1]["root"])) <= 1
+                   for c in candidates.values()):
+                near.add(query["id"])
+        count_before += len(a)
+        count_after += len(b)
+        for identity in sorted(a.keys() - b.keys()):
+            lost.append(dict(query=query["id"], source=a[identity]["source"], fingerprint=identity))
+    return dict(input_sha256={"baseline_db": sha256(baseline_db), "rewritten_db": sha256(rewritten_db),
+                             "queries": sha256(queries)},
+                output_replay_sha256={"controls": sha256(controls), "development": sha256(after)},
+                only_inferred_fields_changed=functions,
+                changed_sources=changed_sources,
+                passed_baseline=sum(bool(row["exact_performance"]) for row in outcomes["controls"]),
+                counterfactual_exact_performance_controls=sorted(native_hits),
+                development_works_near_before=len(near_before),
+                development_works_near_after=len(near_after),
+                development_new_near_works=sorted(near_after - near_before),
+                development_lost_near_works=sorted(near_before - near_after),
+                development_candidates_before=count_before,
+                development_candidates_after=count_after,
+                development_lost_candidates=lost,
+                development_native_witnesses=[
+                    dict(id=row["id"], routes=[route for route in row["routes"] if route["primary_ranks"]])
+                    for row in native if any(route["primary_ranks"] for route in row["routes"])])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--v9a", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--projection-dir", type=Path)
+    args = parser.parse_args()
+    root = args.v9a
+    evaluation = root / "evaluation.json"
+    queries = root / "confirmation/confirmation.jsonl"
+    confirm = root / "confirmation-v9-trace/factory_replay.jsonl"
+    catalog = root / "confirmation-v9-trace/factory_catalog.jsonl"
+    controls = root / "materials/controls.jsonl"
+    controls_replay = root / "controls-v9/factory_replay.jsonl"
+    files = (evaluation, queries, confirm, catalog, controls, controls_replay)
+    outcomes = json.loads(evaluation.read_text(encoding="utf-8"))
+    assert sha256(confirm) == outcomes["trace"]["sha256"]
+    sources = {item["source"]: item for item in read_jsonl(catalog) if item["template_version"] == 9}
+    if args.projection_dir:
+        write_json(args.output, projection_summary(root, args.projection_dir, sources, outcomes))
+        return
+    witnesses = explain_witnesses(queries, confirm, sources)
+    expected = {item["id"] for item in outcomes["per_work"] if item["increment_seam_near"]}
+    assert {item["id"] for item in witnesses} == expected
+    failed = {item["id"] for item in outcomes["controls"] if not item["exact_performance"]}
+    failed_controls = explain_controls(controls, controls_replay, sources, failed)
+    assert {item["source"] for item in failed_controls} == failed
+    routes = [route for item in witnesses for route in item["routes"]]
+    report = dict(
+        input_sha256={path.relative_to(root).as_posix(): sha256(path) for path in files},
+        frozen_overall=outcomes["trace"],
+        native_seam_works=len(witnesses),
+        native_seam_routes=len(routes),
+        exact_first_exits=Counter(item["exact_reason"] for item in routes),
+        contextual_first_exits=Counter(item["contextual_reason"] for item in routes),
+        exact_exit_works=Counter(reason for item in witnesses for reason in
+                                 {route["exact_reason"] for route in item["routes"]}),
+        contextual_exit_works=Counter(reason for item in witnesses for reason in
+                                      {route["contextual_reason"] for route in item["routes"]}),
+        alternate_endpoint_qualified=sum(route["exact_reason"] == "alternate_endpoint" and any(
+            item["disposition"] in ("TARGET_RETAINED", "EXPLORATORY_RETAINED") for item in route["exact_aligned"])
+            for route in routes),
+        native_two_event_context_compatible=sum(item["two_event_context_compatible"] for item in routes),
+        native_terminal_compatible=sum(not item["context_conflicts_from_latest"][0] for item in routes),
+        native_qualified_routes=sum(item["exact_qualified"] or item["contextual_qualified"] for item in routes),
+        native_emitted_routes=sum(bool(item["primary_ranks"] or item["evidence_ranks"]) for item in routes),
+        native_witnesses=witnesses,
+        failed_controls=failed_controls,
+    )
+    write_json(args.output, report)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/v9b/evaluate.py b/tools/v9b/evaluate.py
new file mode 100644
index 0000000..f063fd6
--- /dev/null
+++ b/tools/v9b/evaluate.py
@@ -0,0 +1,221 @@
+"""Compare ordered, qualified Factory routes across frozen libraries."""
+import argparse
+import json
+import statistics
+import sys
+from collections import Counter, defaultdict
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(TOOLS / "b5"), str(TOOLS / "v9a")]
+import evaluate as v9a
+from b5_data import read_jsonl, sha256, write_json, write_jsonl
+from b5_factory import motif
+
+LIBRARIES = ("v8", "v9a", "v9b", "v9b-functions")
+
+
+def tested_performance(events):
+    return [(
+        item["root"], item["bass"] if item["bass"] is not None else item["root"],
+        item["intervals"], round(item["duration"], 5)
+    ) for item in events]
+
+
+def route_motion(route, tonic):
+    def relation(root, quality):
+        pc = (root - tonic) % 12
+        if pc == 0: return "home"
+        if pc == 7 and quality in ("dom", "maj", "sus"): return "dominant"
+        if pc in (2, 5) and quality in ("min", "maj", "dim", "hdim"): return "predominant"
+        if pc in (3, 4, 8, 9, 10): return "mediant/submediant/subtonic"
+        return "other"
+
+    phases = []
+    for root, quality in route:
+        phase = relation(root, quality)
+        if not phases or phases[-1] != phase:
+            phases.append(phase)
+    # Retain the final degree/core quality so unlike endings do not merge.
+    return tuple(phases), ((route[-1][0] - tonic) % 12, route[-1][1])
+
+
+def route_data(candidates, anchor, new, authored):
+    evidence = Counter()
+    shapes = set()
+    motion = set()
+    long_shapes = set()
+    time = defaultdict(set)
+    qualified_sources = set()
+    split = Counter()
+    for candidate in candidates:
+        events = candidate["events"]
+        relative = motif(events, anchor)
+        if candidate["source"] in new:
+            split["new_candidates"] += 1
+            qualified_sources.add(candidate["source"])
+        if not candidate["source_end_preserved"] or len(relative) < 3:
+            continue
+        shapes.add(relative)
+        if len(relative) >= 6:
+            long_shapes.add(relative)
+        tonic = candidate["key"] % 12
+        motion.add(route_motion(motif(events, 0), tonic))
+        timing = tuple(round(item["duration"], 6) for item in v9a.collapse(events))
+        time[relative].add(timing)
+        if candidate["source"] in authored and candidate["next"] == authored[candidate["source"]]["boundary"]:
+            evidence["authored_boundary"] += 1
+        elif candidate["structure_qualified"] and candidate["reviewed_ending"]:
+            evidence["worker_reviewed"] += 1
+        elif candidate["complete_source_phrase"]:
+            evidence["whole_source_unconfirmed_structure"] += 1
+        elif candidate["provenance"] == 0:
+            evidence["internal_source_tail"] += 1
+        else:
+            evidence["algorithm_assessed"] += 1
+    for n in (3, 10):
+        first = candidates[:n]
+        split[f"top{n}_new"] = sum(x["source"] in new for x in first)
+        split[f"top{n}_route_count"] = len({motif(x["events"], anchor) for x in first})
+        split[f"top{n}_editorial_families"] = len({x["family"] or x["source"] for x in first})
+        split[f"top{n}_repeated_primary_sources"] = len(first) - len({x["source"] for x in first})
+    return dict(routes=len(shapes), motion_routes=len(motion), long_routes=len(long_shapes),
+                rhythmic_variants=sum(len(variants)-1 for variants in time.values()),
+                evidence=dict(evidence), qualified_new_sources=sorted(qualified_sources), **split)
+
+
+def measure(query, replay, catalog, manifest, authored, source_events):
+    anchor = query["prefix"][-1]["root"]
+    target = v9a.collapse(query["target"])
+    base = v9a.probe(target, anchor, replay, catalog, query["prefix"][-1].get("meter"), manifest, source_events)
+    return base | route_data(replay["candidates"], anchor, manifest, authored)
+
+
+def stats(rows, edition):
+    result = v9a.aggregate(rows, edition)
+    items = [row[edition] for row in rows]
+    for label in ("routes", "motion_routes", "long_routes", "rhythmic_variants", "top3_route_count",
+                  "top10_route_count", "top3_editorial_families", "top10_editorial_families",
+                  "top3_repeated_primary_sources", "top10_repeated_primary_sources"):
+        result[f"median_{label}"] = statistics.median(item.get(label, 0) for item in items)
+    result["works_at_least_two_routes"] = sum(item["routes"] >= 2 for item in items)
+    result["works_at_least_two_long_routes"] = sum(item["long_routes"] >= 2 for item in items)
+    result["works_with_route_gain_vs_v9a"] = sum(item["new_source_routes_vs_v9a"] > 0 for item in items)
+    result["new_source_routes_vs_v9a"] = sum(item["new_source_routes_vs_v9a"] for item in items)
+    result["works_with_motion_gain_vs_v9a"] = sum(item["motion_routes"] > row["v9a"]["motion_routes"]
+                                                 for item, row in zip(items, rows, strict=True))
+    result["top3_new"] = sum(item.get("top3_new", 0) for item in items)
+    result["top10_new"] = sum(item.get("top10_new", 0) for item in items)
+    result["observed_new_sources"] = len({source for item in items for source in item["qualified_new_sources"]})
+    result["lost_v9a_music"] = sum(item["lost_v9a_music"] for item in items)
+    result["lost_content_only_music"] = sum(item["lost_content_only_music"] for item in items)
+    result["generated_identity_changes"] = sum(not item["generated_same_as_v9a"] for item in items)
+    categories = Counter()
+    for item in items:
+        categories.update(item["evidence"])
+    result["evidence"] = dict(categories)
+    return result
+
+
+def compare(queries, root, name, manifest, authored):
+    query_path = Path(queries)
+    freeze_path = query_path.with_name(f"{name}-freeze.json")
+    freeze = json.loads(freeze_path.read_text(encoding="utf-8"))
+    query_hash = sha256(query_path)
+    if query_hash != freeze["sha256"]:
+        raise ValueError(f"{name}: confirmation input differs from freeze")
+    inputs = [root / f"{name}-{edition}" for edition in LIBRARIES]
+    identities = [json.loads((path / "factory_identity.json").read_text(encoding="utf-8")) for path in inputs]
+    for declared, version, count in zip(identities, (8, 9, 9, 9), (1288, 1312, 1332, 1332), strict=True):
+        if (declared["factory_schema"] != 2 or declared["factory_version"] != version
+                or declared["factory_count"] != count or declared["queries"] != freeze["works"]
+                or declared["user_count"] != 0 or declared["recover_consumed_tail"]):
+            raise ValueError(f"{name}: unexpected Worker identity {declared}")
+    catalogs = [v9a.catalog(path / "factory_catalog.jsonl", None) for path in inputs]
+    new_ids = set(manifest)
+    source_events = {row["source"]: row["events"] for row in read_jsonl(inputs[-1] / "factory_catalog.jsonl")
+                     if row["source"] in new_ids}
+    rows, cohorts = [], defaultdict(list)
+    ids, works = set(), set()
+    for query, *replays in zip(read_jsonl(query_path),
+                               *(read_jsonl(path / "factory_replay.jsonl") for path in inputs), strict=True):
+        identity = query["id"]
+        assert (identity not in ids and query["group"] not in works
+                and all(replay["id"] == identity for replay in replays))
+        ids.add(identity)
+        works.add(query["group"])
+        row = dict(id=identity, groups=["all", *v9a.tags(query)])
+        baseline = {c["fingerprint"]: c for c in replays[1]["candidates"]}
+        content_only = {c["fingerprint"] for c in replays[2]["candidates"]}
+        anchor = query["prefix"][-1]["root"]
+        baseline_routes = {motif(c["events"], anchor) for c in baseline.values() if c["source_end_preserved"]}
+        for edition, replay, catalog in zip(LIBRARIES, replays, catalogs, strict=True):
+            data = measure(query, replay, catalog, manifest, authored, source_events)
+            existing = {c["fingerprint"]: c for c in replay["candidates"]}
+            for fingerprint in existing.keys() & baseline.keys():
+                assert tested_performance(existing[fingerprint]["events"]) == tested_performance(
+                    baseline[fingerprint]["events"]), (identity, edition, fingerprint)
+            data["lost_v9a_music"] = len(baseline.keys() - existing.keys())
+            data["lost_content_only_music"] = len(content_only - existing.keys()) if edition == LIBRARIES[-1] else 0
+            data["generated_same_as_v9a"] = replay["generated_identities"] == replays[1]["generated_identities"]
+            new_routes = {motif(c["events"], anchor) for c in existing.values()
+                          if c["source"] in new_ids and c["source_end_preserved"]}
+            data["new_source_routes_vs_v9a"] = sum(len(route) >= 3 for route in new_routes - baseline_routes)
+            row[edition] = data
+        rows.append(row)
+        for label in row["groups"]:
+            cohorts[label].append(row)
+    assert len(works) == freeze["works"]
+    return dict(input_sha256=query_hash, works=len(rows), libraries=dict(zip(LIBRARIES, identities, strict=True)),
+                cohorts={label: {edition: stats(group, edition) for edition in LIBRARIES}
+                         for label, group in cohorts.items()}, per_work=rows)
+
+
+def controls(queries, root, name):
+    records = []
+    path = root / name / "factory_replay.jsonl"
+    for query, replay in zip(read_jsonl(queries), read_jsonl(path), strict=True):
+        assert query["id"] == replay["id"]
+        planned = tested_performance(query["target"])
+        candidates = [c for c in replay["candidates"]
+                      if c["source"] == query["id"] and c["source_end_preserved"] and
+                      c["next"] == len(query["prefix"])]
+        records.append(dict(id=query["id"], observed_source=any(c["source"] == query["id"] for c in replay["candidates"]),
+                            intended_tail=bool(candidates), intended_performance=any(
+                                tested_performance(c["events"]) == planned for c in candidates),
+                            snapshot_sources=replay.get("snapshot_sources", 0),
+                            exact_dispositions=Counter(row["disposition"] for row in replay["exact_trace"]),
+                            contextual_dispositions=Counter(row["disposition"] for row in replay["context_trace"])))
+    return records
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence", required=True, type=Path)
+    parser.add_argument("--cohort", action="append", default=[])
+    parser.add_argument("--v9a", type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--prepare-hard-control", action="store_true")
+    args = parser.parse_args()
+    root = args.evidence
+    queries = root / "materials/controls.jsonl"
+    if args.prepare_hard_control:
+        control = next(item for item in read_jsonl(queries) if item["id"] == "V9B_004")
+        # C natural conflicts with the first authored D-major triad.
+        control["hard_melody"] = dict(pitch_class=0, onset=control["target"][0]["onset"], duration=1)
+        write_jsonl(args.output, [control])
+        return
+    manifest = {row["id"]: row for row in json.loads((root / "materials/manifest.json").read_text())["entries"]}
+    if args.v9a is None:
+        parser.error("--v9a is required for evaluation")
+    v9a_entries = json.loads((args.v9a / "materials/manifest.json").read_text())["entries"]
+    authored = {row["id"]: row for row in v9a_entries} | manifest
+    report = dict(results={name: compare(root / "confirmation" / f"{name}.jsonl", root, name, manifest, authored)
+                           for name in args.cohort},
+                  controls={edition: controls(queries, root, f"controls-{edition}")
+                            for edition in LIBRARIES[2:]})
+    write_json(args.output, report)
+
+
+if __name__ == "__main__":
+    main()
